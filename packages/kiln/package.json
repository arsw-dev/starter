{
  "name": "@arsw/kiln",
  "version": "0.0.0",
  "description": "An API framework on Hono for Cloudflare Workers: OpenAPI routes with one error shape, and, under /model, Drizzle tables on D1 and Zod schemas from one model",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsw-dev/starter.git",
    "directory": "packages/kiln"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/main.ts",
    "./model": "./src/model.ts",
    "./document": "./src/document.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      },
      "./model": {
        "types": "./dist/model.d.mts",
        "default": "./dist/model.mjs"
      },
      "./document": {
        "types": "./dist/document.d.mts",
        "default": "./dist/document.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "prepare": "wrangler types",
    "types": "wrangler types",
    "build": "vp pack"
  },
  "devDependencies": {
    "@arsw/tsconfig": "workspace:*",
    "@arsw/vite-config": "workspace:*",
    "@cloudflare/vitest-plugin": "catalog:tooling",
    "@hono/zod-openapi": "catalog:api",
    "@types/node": "catalog:tooling",
    "drizzle-orm": "catalog:api",
    "hono": "catalog:api",
    "vite-plus": "catalog:tooling",
    "wrangler": "catalog:tooling",
    "zod": "catalog:shared"
  },
  "peerDependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
