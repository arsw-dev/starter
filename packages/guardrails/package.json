      "./plugin": "./dist/main.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "devDependencies": {
    "@arsw/tsconfig": "workspace:*",
    "@types/node": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  }
}
