{
  "name": "@arsw/guardrails",
  "version": "0.1.0",
  "description": "oxlint rules for what its built-in rules don't cover: layout, exports, imports and comments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsw-dev/starter.git",
    "directory": "packages/guardrails"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
