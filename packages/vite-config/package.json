  },
  "dependencies": {
    "@arsw/guardrails": "workspace:^"
  },
  "devDependencies": {
    "@arsw/tsconfig": "workspace:*",
    "@types/node": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  },
  "peerDependencies": {
    "vite-plus": "^1.2.0"
  }
}
