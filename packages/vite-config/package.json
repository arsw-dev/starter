{
  "name": "@arsw/vite-config",
  "version": "0.1.3",
  "description": "Vite+ settings shared across repos: formatting, lint with the guardrails rules, and library builds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsw-dev/starter.git",
    "directory": "packages/vite-config"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/main.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/main.d.mts",
