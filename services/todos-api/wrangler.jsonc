{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todos-api",
  "main": "src/main.ts",
  "compatibility_date": "2026-10-15",
  // Reached only through its front end's service binding: no public URL, so
  // nothing reaches it without going through the app's checks
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todos",
      "migrations_dir": "migrations",
    },
  ],
}
